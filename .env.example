# Copy to .env.local for local development, and set the same values in the
# host's build environment (Netlify / Vercel / Cloudflare Pages → Environment
# variables). All of these are meant to be public: they are read by the browser,
# and what can actually be written is fixed by the Appwrite table and bucket
# permissions that scripts/setup-appwrite.mjs applies.
#
# scripts/setup-appwrite.mjs writes this file for you.
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_DATABASE_ID=roadmaster
NEXT_PUBLIC_APPWRITE_TABLE_ID=gallery_items
NEXT_PUBLIC_APPWRITE_BUCKET_ID=gallery

# Optional. The email behind the "Admin" username. Only change this if you
# re-run the setup script, which pins write permission to that account.
# NEXT_PUBLIC_ADMIN_EMAIL=admin@roadmastertyreservices.co.za
